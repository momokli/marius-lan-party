# ─────────────────────────────────────────────────────────────
# LAN-Party Server-Stack — Umgebungsvariablen (Vorlage)
# 1. Kopieren:  cp .env.example .env
# 2. Werte eintragen (Passwörter, Tokens)
# 3. .env NIE committen (steht in .gitignore)
# ─────────────────────────────────────────────────────────────

# ── Allgemein ────────────────────────────────────────────────
# Absoluter Host-Pfad zu diesem server-stack-Ordner. Wird nur von der
# Control-UI im Docker-Modus gesetzt; nativ (node server.js) einfach "." lassen.
SERVER_STACK_DIR=.

# ── Factorio ─────────────────────────────────────────────────
# Name der Save-Datei (wird beim ersten Start neu erzeugt)
FACTORIO_SAVE_NAME=lan-party
# Passwort/Kommentar in ./data/factorio/config/server-settings.json setzen
# (game_password, admins, autosave_interval, max_upload_speed …) — siehe docs/factorio.md

# ── Minecraft (Paper) ────────────────────────────────────────
# Version pinnen für Stabilität, z.B. 1.21.4 (latest = immer neueste)
MC_VERSION=latest
MC_MAX_PLAYERS=8
MC_VIEW_DISTANCE=12
# TRUE = nur echte Mojang-Accounts, FALSE = Offline-Modus (jeder kann joinen)
MC_ONLINE_MODE=TRUE
# Whitelist (Komma-getrennte Spielernamen) — empfohlen für die Party
MC_ENABLE_WHITELIST=FALSE
MC_WHITELIST=

# ── Minecraft: Reign of Nether (Forge 1.20.1) ─────────────────
# CurseForge-Modpack-URL (AUTO_CURSEFORGE installiert Modpack + Loader automatisch)
REIGN_CF_PAGE_URL=https://www.curseforge.com/minecraft/modpacks/reign-of-nether-rts
# Optional: eigener CurseForge-API-Key (das Image bringt ab Java 17 einen eingebauten mit)
CF_API_KEY=

# ── Counter-Strike 2 ─────────────────────────────────────────
# GSLT-Token: https://steamcommunity.com/dev/managegameservers → App 730 (CS2)
# Für reines LAN (sv_lan 1) optional, für öffentliche Server Pflicht.
CS2_GSLT_TOKEN=
CS2_SERVERNAME=LAN-Party CS2
CS2_PASSWORD=
CS2_RCON_PASSWORD=change-me

# ── Left 4 Dead 2 ────────────────────────────────────────────
# Nur für x86_64-Hosts (läuft NICHT auf Apple Silicon, srcds ist 32-bit).
# Einstellungen direkt in docker-compose.l4d2.yml (command-Args) anpassen.

# ── Satisfactory ─────────────────────────────────────────────
SATISFACTORY_MAXPLAYERS=4
# true = Experimental-Branch, false = Stable
SATISFACTORY_STEAMBETA=false
